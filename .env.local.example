# Copiar a .env.local y completar con valores reales. Nunca commitear .env.local.

# Supabase (públicas: protegidas por RLS, es seguro exponerlas al cliente)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API key server-only que deben enviar los clientes del endpoint /api/priorizacion
# en el header x-api-key. Generar con: openssl rand -hex 32
PRIORIZACION_API_KEY=

# Solo en producción: permite servir datos de ejemplo si Supabase falla (por defecto
# está deshabilitado en producción para no mostrar existencias falsas como reales).
# PERMITIR_DATOS_EJEMPLO=true
